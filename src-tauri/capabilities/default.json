{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's pages, served by the sidecar on 127.0.0.1 (random port): menus, file dialogs, the diagnostics export, updates, files opened from the system, the title bar's color mode and opening Colwerk's web pages.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:menu:default",
    "core:resources:default",
    "core:event:allow-listen",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-export-diagnostics",
    "allow-pause-server",
    "allow-resume-server",
    "allow-take-opened-files",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }, { "url": "https://colwerk.app/*" }]
    }
  ]
}
