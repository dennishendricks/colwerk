{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colwerk",
  "mainBinaryName": "colwerk",
  "version": "../package.json",
  "identifier": "app.colwerk",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "SQL editor and database client",
    "license": "MIT",
    "fileAssociations": [
      {
        "ext": ["sql"],
        "name": "SQL Query",
        "description": "SQL Query",
        "role": "Editor",
        "mimeType": "application/sql",
        "exportedType": { "identifier": "app.colwerk.sql", "conformsTo": ["public.plain-text"] }
      },
      {
        "ext": ["sqlplan"],
        "name": "SQL Server Execution Plan",
        "description": "SQL Server Execution Plan",
        "role": "Viewer",
        "mimeType": "application/xml",
        "exportedType": { "identifier": "app.colwerk.sqlplan", "conformsTo": ["public.xml"] }
      },
      {
        "ext": ["duckdb"],
        "name": "DuckDB Database",
        "description": "DuckDB Database",
        "role": "Editor",
        "mimeType": "application/x-duckdb",
        "exportedType": { "identifier": "app.colwerk.duckdb", "conformsTo": ["public.database", "public.data"] }
      },
      {
        "ext": ["sqlite", "sqlite3"],
        "name": "SQLite Database",
        "description": "SQLite Database",
        "role": "Editor",
        "mimeType": "application/vnd.sqlite3",
        "exportedType": { "identifier": "app.colwerk.sqlite", "conformsTo": ["public.database", "public.data"] }
      },
      {
        "ext": ["csv", "tsv"],
        "name": "Delimited Text Data",
        "description": "CSV or TSV data",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/csv"
      },
      {
        "ext": ["parquet"],
        "name": "Parquet Data",
        "description": "Apache Parquet data",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.apache.parquet"
      },
      {
        "ext": ["json", "ndjson", "jsonl"],
        "name": "JSON Data",
        "description": "JSON or NDJSON data",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/json"
      },
      {
        "ext": ["xlsx"],
        "name": "Excel Workbook",
        "description": "Excel workbook",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBRTYyODg4MzBEODQ4MzkKUldRNVNOZ3dpQ2ptQ2k1ZytkdFlyVXlvbTdTcFpxZWF2eVdjUXpudkRSbEkwUU1jY2VhamM5R3MK",
      "endpoints": ["https://github.com/dennishendricks/colwerk/releases/latest/download/latest.json"]
    }
  }
}
