  "repository": {
    "type": "git",
    "url": "https://github.com/dennishendricks/colwerk"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "desktop": "bun scripts/package.ts desktop",
    "compile": "bun scripts/package.ts compile",
    "release": "bun scripts/release.ts",
    "hooks": "git config core.hooksPath .githooks",
