    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@duckdb/node-bindings": "2.0.0-r.1",
    "@iconify-json/lucide": "^1.2.150",
    "@lezer/highlight": "^1.2.5",
    "@nuxt/ui": "^4.12.0",
