{
  "nodeModulesDir": "auto",
  "unstable": ["fmt-component"],
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [".nuxt", ".output", "dist", "src-tauri/target", "src-tauri/gen"]
  },
  "tasks": {
    "dev": "deno run -A scripts/dev.ts",
    "desktop": "deno run -A scripts/package.ts desktop",
    "compile": "deno run -A scripts/package.ts compile",
    "release": "deno run -A scripts/release.ts",
    "fmt": "deno fmt",
    "hooks": "git config core.hooksPath .githooks",
    "lint": "deno run -A npm:nuxt prepare && deno run -A npm:eslint .",
    "lint:fix": "deno run -A npm:nuxt prepare && deno run -A npm:eslint --fix .",
    "test": "deno test -A --v8-flags=--expose-gc tests/",
    "typecheck": "deno check core/ launcher/ scripts/ tests/ && deno run -A npm:nuxt typecheck"
  }
}
