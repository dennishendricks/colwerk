---
// The app's shortcut overview, generated from app/utils/shortcuts.ts (src/data/reference.json, scripts/docs-data.ts).
import reference from '../../data/reference.json'
import { formatKeys } from '../../keys'
---

<table>
  <thead>
    <tr>
      <th>Keys</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    {
      reference.shortcuts.map((s) => {
        const { mac, other } = formatKeys(s.keys)
        return (
          <tr>
            <td>
              <span class="kbd">
                <kbd class="mac">{mac}</kbd>
                <kbd class="other">{other}</kbd>
              </span>
            </td>
            <td>{s.label}</td>
          </tr>
        )
      })
    }
  </tbody>
</table>
