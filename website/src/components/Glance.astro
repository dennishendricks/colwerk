---
// "Colwerk at a glance" on the landing page: a quotable summary, key facts and who it is for (texts in src/content/i18n).
const { t } = Astro.locals
const facts = ([1, 2, 3, 4, 5, 6, 7, 8, 9] as const).map((i) => [t(`landing.glance.fact${i}.label`), t(`landing.glance.fact${i}.value`)])
const fitLinks = ['/postgresql-gui/', '/sql-server-gui/', '/duckdb-gui/', '/docs/reference/security/', '/docs/mcp/']
const fits = ([1, 2, 3, 4, 5] as const).map((i) => ({ href: fitLinks[i - 1], text: t(`landing.glance.fit${i}`) }))
const notFits = ([1, 2, 3] as const).map((i) => t(`landing.glance.notFit${i}`))
---

<section id="at-a-glance" class="cw-section not-content">
  <p class="cw-eyebrow">{t('landing.glance.eyebrow')}</p>
  <h2>{t('landing.glance.title')} <span>Colwerk?</span></h2>
  <p class="cw-lead">{t('landing.glance.summary')}</p>

  <dl class="facts">
    {
      facts.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="who">
    <div>
      <h3>{t('landing.glance.fitsTitle')}</h3>
      <ul class="fit">
        {
          fits.map((f) => (
            <li>
              <a href={f.href}>{f.text}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>{t('landing.glance.notFitsTitle')}</h3>
      <ul class="no-fit">{notFits.map((n) => <li>{n}</li>)}</ul>
      <p class="cw-muted small" set:html={t('landing.glance.limits')} />
    </div>
  </div>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem 2.5rem;
    margin: 2.5rem 0 0;
  }
  .facts div {
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .facts dt {
    color: var(--sl-color-white);
    font-weight: 650;
  }
  .facts dd {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-3);
  }
  .who {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 2rem 4rem;
    margin-top: 3rem;
  }
  .who ul {
    display: grid;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .who li {
    padding-left: 1.5rem;
    text-indent: -1.5rem;
  }
  .who li::before {
    display: inline-block;
    width: 1.5rem;
    text-indent: 0;
    font-weight: 700;
  }
  .fit li::before {
    content: '✓';
    color: var(--sl-color-text-accent);
  }
  .no-fit li::before {
    content: '✕';
    color: var(--sl-color-gray-3);
  }
  .who a {
    color: var(--sl-color-gray-2);
  }
  .who a:hover,
  .small a {
    color: var(--sl-color-text-accent);
  }
  .small {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
  }
</style>
