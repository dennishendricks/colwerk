---
// Starlight's footer plus links to the pages per engine and topic, copyright and the legal pages.
import { guides } from '../config'
import Default from '@astrojs/starlight/components/Footer.astro'
import { repo } from '../config'
---

<Default />
<nav class="guides" aria-label="Colwerk for">
  {guides.map((g) => <a href={g.href}>{g.label}</a>)}
</nav>
<p class="legal">
  © 2026 Dennis Hendricks · MIT License · <a href="/imprint/">Imprint</a> · <a href="/privacy/">Privacy policy</a> ·
  <a href={repo}>GitHub</a>
</p>

<style>
  .guides {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    margin-top: 2rem;
    font-size: var(--sl-text-sm);
  }
  .guides a {
    color: var(--sl-color-gray-3);
  }
  .legal {
    margin-top: 2rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
  .legal a {
    color: inherit;
  }
</style>
