---
// Feature section of the landing page: numbered spec list "Under the hood" and the "Every day" grid, each item linked to
// its docs page (texts in src/content/i18n).
const { t } = Astro.locals

const specLinks = [
  '/docs/editor/transactions/',
  '/docs/data/schema-tree/',
  '/docs/editor/safety/',
  '/docs/data/export/',
  '/docs/mcp/',
  '/docs/reference/security/',
]
// text is HTML (<kbd>)
const cardLinks = [
  '/docs/data/result-grid/',
  '/docs/data/schema-tree/',
  '/docs/reference/shortcuts/',
  '/docs/editor/running-queries/',
  '/docs/data/schema-tree/',
  '/docs/editor/',
  '/docs/editor/tabs/',
  '/docs/editor/tabs/',
]
const specs = ([1, 2, 3, 4, 5, 6] as const).map((i) => ({
  href: specLinks[i - 1],
  title: t(`landing.features.spec${i}.title`),
  text: t(`landing.features.spec${i}.text`),
}))
const cards = ([1, 2, 3, 4, 5, 6, 7, 8] as const).map((i) => ({
  href: cardLinks[i - 1],
  title: t(`landing.features.card${i}.title`),
  text: t(`landing.features.card${i}.text`),
}))
---

<section id="features" class="cw-section not-content">
  <h2>{t('landing.features.title')} <span>{t('landing.features.accent')}</span></h2>

  <div class="group">
    <p class="cw-eyebrow">{t('landing.features.specs')}</p>
    <dl class="specs">
      {
        specs.map((f) => (
          <div>
            <dt>
              <a href={f.href}>{f.title}</a>
            </dt>
            <dd>{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="group">
    <p class="cw-eyebrow">{t('landing.features.cards')}</p>
    <div class="daily">
      {
        cards.map((f) => (
          <article>
            <h3>
              <a href={f.href}>{f.title}</a>
            </h3>
            <p set:html={f.text} />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .group {
    margin-top: 2.5rem;
  }
  .specs {
    margin: 0;
    counter-reset: spec;
  }
  .specs div {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.5rem 2.5rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .specs div:last-child {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .specs dt {
    color: var(--sl-color-white);
    font-size: 1.15rem;
    font-weight: 650;
  }
  .specs dt::before {
    counter-increment: spec;
    content: counter(spec, decimal-leading-zero);
    margin-right: 0.9rem;
    color: var(--cw-brand);
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
  }
  .specs a,
  .daily h3 a {
    color: inherit;
    text-decoration: none;
  }
  .specs a:hover,
  .daily h3 a:hover {
    color: var(--sl-color-text-accent);
  }
  .specs dd {
    margin: 0;
    color: var(--sl-color-gray-3);
  }
  .daily {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2.5rem 2rem;
    margin-top: 1rem;
  }
  .daily article {
    padding-left: 1rem;
    border-left: 2px solid var(--cw-brand-dim);
  }
  .daily p {
    margin: 0;
    color: var(--sl-color-gray-3);
  }
  .daily :global(kbd) {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
  }
</style>
