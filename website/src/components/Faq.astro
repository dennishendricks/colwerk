---
// FAQ section of the landing page: sticky intro beside an accordion.
import { repo } from '../config'

const faqs = [
  {
    q: 'Is Colwerk really free?',
    a: 'Yes. Colwerk is open source under the MIT license. There is no paid tier, no account and no trial. The source code is on GitHub for anyone to read and audit.',
  },
  {
    q: 'Which databases does Colwerk support?',
    a: 'SQLite, PostgreSQL, MySQL and MariaDB, SQL Server, ClickHouse and DuckDB. Through DuckDB, Colwerk also reads lakehouses: Apache Iceberg, Delta Lake, Databricks Unity Catalog and Microsoft Fabric OneLake.',
  },
  {
    q: 'Which operating systems are supported?',
    a: 'macOS on Apple Silicon, Windows on x64 and Linux on x64 and arm64 as a .deb package. On macOS and Windows, Colwerk installs signed updates itself.',
  },
  {
    q: 'Does Colwerk collect any data?',
    a: 'No. There is no telemetry, no analytics and no account. Queries go directly from your computer to your databases. Colwerk only contacts GitHub to check for updates and load release notes, and downloads the DuckDB library and its extensions the first time they are needed.',
  },
  {
    q: 'Where are my passwords stored?',
    a: 'On your computer only. Passwords are encrypted with AES-256-GCM, and the key lives in your operating system’s keychain. They are never shown to an AI assistant.',
  },
  {
    q: 'Does Colwerk include AI?',
    a: 'No. Colwerk has a built-in MCP server instead, so you can connect Claude, ChatGPT or any other MCP client you already use. Your AI can explore schemas and run read-only queries, and hands its final query to a new tab. You decide what runs.',
  },
  {
    q: 'Can I use Colwerk with my production database?',
    a: 'Yes, with guard rails. Give the connection a color, for example red, and it marks the sidebar, tabs and toolbar. On request, Colwerk asks before any statement that may change data or structures. New tabs start with a 200-row limit and a 60-second timeout.',
  },
]
---

<section id="faq" class="faq cw-section not-content">
  <div class="intro">
    <p class="cw-eyebrow">FAQ</p>
    <h2>Questions, <span>answered.</span></h2>
    <p class="cw-muted">Something missing? <a href={`${repo}/issues`}>Ask on GitHub</a>.</p>
  </div>
  <div class="list">
    {
      faqs.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem 4rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .faq {
      grid-template-columns: 1fr 2fr;
    }
    .intro {
      position: sticky;
      top: calc(var(--sl-nav-height) + 2rem);
    }
  }
  .intro a {
    color: var(--sl-color-text-accent);
  }
  .list {
    border-top: 1px solid var(--sl-color-gray-5);
  }
  details {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.25rem;
    color: var(--sl-color-white);
    font-size: 1.1rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 50%;
    color: var(--sl-color-text-accent);
    background:
      linear-gradient(currentColor, currentColor) center / 0.75rem 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px 0.75rem no-repeat;
    transition: transform 0.2s;
  }
  summary:hover {
    color: var(--sl-color-text-accent);
  }
  details[open] summary::after {
    transform: rotate(45deg);
    border-color: var(--cw-brand);
  }
  details p {
    max-width: 42rem;
    margin: -0.25rem 0 0;
    padding: 0 3rem 1.5rem 0;
    color: var(--sl-color-gray-3);
  }
  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
</style>
