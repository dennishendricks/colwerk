---
// Privacy section of the landing page: a full-width band with four key figures (texts in src/content/i18n).
const { t } = Astro.locals

const figures = ['DE', '0', '0', '256-bit']
const points = ([1, 2, 3, 4] as const).map((i) => ({
  figure: figures[i - 1],
  title: t(`landing.privacy.point${i}.title`),
  text: t(`landing.privacy.point${i}.text`),
}))
---

<section id="privacy" class="privacy cw-section not-content">
  <p class="cw-eyebrow">{t('landing.privacy.eyebrow')}</p>
  <h2>{t('landing.privacy.title')} <span>{t('landing.privacy.accent')}</span></h2>
  <p class="cw-lead">{t('landing.privacy.lead')}</p>
  <div class="points">
    {
      points.map((p) => (
        <article>
          <strong class="figure">{p.figure}</strong>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* full-bleed band behind the centered content */
  .privacy {
    background: var(--sl-color-gray-6);
    box-shadow: 0 0 0 100vmax var(--sl-color-gray-6);
    clip-path: inset(0 -100vmax);
  }
  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  article {
    padding-left: 1.25rem;
    border-left: 1px solid var(--sl-color-gray-5);
  }
  .figure {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--sl-color-text-accent);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  article p {
    margin: 0;
    color: var(--sl-color-gray-3);
  }
</style>
