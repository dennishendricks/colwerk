---
// Starlight's head plus the apple-touch-icon, rendered as PNG from the SVG at build time (iOS ignores SVG icons).
import Default from '@astrojs/starlight/components/Head.astro'
import { getImage } from 'astro:assets'
import appleTouchIconSvg from '../assets/apple-touch-icon.svg'

const appleTouchIcon = await getImage({ src: appleTouchIconSvg, format: 'png', width: 180, height: 180 })
---

<Default />
<!-- Shortcuts in macOS notation on Apple devices (src/keys.ts), before the page renders -->
<script is:inline>
  if (/mac|iphone|ipad|ipod/i.test(navigator.userAgentData?.platform ?? navigator.platform))
    document.documentElement.dataset.platform = 'mac'
</script>
<link rel="apple-touch-icon" href={appleTouchIcon.src} />
