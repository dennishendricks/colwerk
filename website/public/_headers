# Everything else, HTML included, gets Cloudflare's default `public, max-age=0, must-revalidate`, so a release shows
# up at once.

# File names under /_assets/ contain a content hash, so they never change
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# The search index files of Pagefind are named by their content hash as well
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed names that rarely change
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.jpg
  Cache-Control: public, max-age=86400
